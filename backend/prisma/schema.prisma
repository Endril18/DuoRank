// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
// Criar migração com o banco: npx prisma migrate dev --name init
// Gerar o Prisma Client: npx prisma generate

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") // Pega URL do banco de dados do arquivo .env
}

model Poliglota {
  id        Int      @id @default(autoincrement())
  nome      String   @unique
  idiomas   String
  xp        Int      @default(0) // total atual
  ofensiva  Int      @default(0)
  ultimaAtividade DateTime?
  historico HistoricoXP[] // Um poliglota pode ter muitos históricos
}

model HistoricoXP {
  id          Int       @id @default(autoincrement())
  poliglotaId Int
  xpAlterado  Int       // Quantidade de XP ganhos
  data        DateTime  @default(now()) // Data do evento
  poliglota   Poliglota @relation(fields: [poliglotaId], references: [id])
}

